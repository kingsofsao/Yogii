# =============================================================================
# Yogii configuration template. PLACEHOLDERS ONLY: never commit real values.
# Copy to .env for local development. In production, inject these from a
# secrets manager, not from a file in the repository.
# =============================================================================

# development | test | production
APP_ENV=development

# --- Payment rail -------------------------------------------------------------
# Yogii can only run in simulation. Live mode needs BOTH of the settings below
# and an implemented, authorised sponsor-bank adapter, which does not exist.
# Users cannot change these; only the server deployment can.
PAYMENT_MODE=simulation
LIVE_PAYMENTS_ENABLED=false
SPONSOR_BANK_ADAPTER=
# HMAC secret the simulated rail uses to sign its status callbacks.
MOCK_PROVIDER_WEBHOOK_SECRET=<generate: openssl rand -hex 32>

# --- Database -----------------------------------------------------------------
# Local development may use SQLite; production must use PostgreSQL with the
# least-privilege application role (see docs/DEPLOYMENT.md).
DATABASE_URL=sqlite:///./backend/data/yogii.db
# DATABASE_URL=postgresql://yogii_app:<app-password>@localhost:5432/yogii
DB_AUTO_CREATE=true
SEED_DEMO_DATA_ON_STARTUP=false

# Docker Compose only: database owner (runs migrations) and application roles.
POSTGRES_DB=yogii
POSTGRES_PASSWORD=<superuser password for the postgres container>
YOGII_MIGRATOR_PASSWORD=<password for the schema owner role>
YOGII_APP_PASSWORD=<password for the least-privilege application role>

# --- Sessions -----------------------------------------------------------------
JWT_SECRET=<generate: openssl rand -hex 32>
ACCESS_TOKEN_EXPIRE_MINUTES=30
# true whenever the app is served over HTTPS (required in production)
COOKIE_SECURE=false

# --- Application-level encryption ----------------------------------------------
# 32-byte keys, hex-encoded (64 hex characters). Keep them apart from backups.
YOGII_ENCRYPTION_KEY=<generate: openssl rand -hex 32>
YOGII_LOOKUP_HMAC_KEY=<generate: openssl rand -hex 32>
YOGII_KEY_VERSION=v1

# --- Risk model and prototype policy ------------------------------------------
MODEL_DIR=backend/model
MODEL_VERSION=2.0.0-synthetic
# Yogii prototype thresholds (0-100). Not RBI, NPCI or bank standards.
RISK_THRESHOLD_MEDIUM=30
RISK_THRESHOLD_HIGH=60
RISK_THRESHOLD_VERY_HIGH=85
# 7, 30 or 90
FEATURE_HISTORY_DAYS=30
# 1, 2 or 3 (3 is for demos only)
GRAPH_MAX_DEPTH=2

# --- Limits, retention, HTTP ------------------------------------------------------
MAX_PAYMENT_AMOUNT=100000
DEMO_STARTING_BALANCE=50000
RETENTION_FEATURE_SNAPSHOT_DAYS=180
RETENTION_SECURITY_EVENT_DAYS=365
RETENTION_GRAPH_EDGE_DAYS=90
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
