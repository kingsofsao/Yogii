# ==============================================================================
# Yogii Secure Digital Payment & Fraud Risk Platform
# Environment Configuration Template
# ==============================================================================

APP_ENV=development
DEBUG=true

# Database (PostgreSQL in Docker, SQLite locally)
# Example PostgreSQL: postgresql://yogii_user:yogii_secret_password@localhost:5432/yogii_db
# Example SQLite: sqlite:///./data/yogii.db
DATABASE_URL=sqlite:///./data/yogii.db

# Redis Cache & Message Broker
REDIS_URL=redis://localhost:6379/0

# JWT Authentication
# In production, generate using: openssl rand -hex 32
JWT_SECRET=super-secret-yogii-jwt-dev-key-change-in-production-12345
JWT_EXPIRY=1440

# AES-256-GCM Application-Level Encryption (32-byte hex string = 64 characters)
# In production, inject directly from AWS KMS, HashiCorp Vault, or Azure Key Vault
YOGII_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# HMAC-SHA-256 Blind Index Key (32-byte hex string = 64 characters)
YOGII_LOOKUP_HMAC_KEY=fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210

# Key Versioning Metadata for Safe Rotation
YOGII_KEY_VERSION=v1

# Payment Rail Modes (STRICT INVARIANT: default must always be simulation)
PAYMENT_MODE=simulation
LIVE_UPI_ENABLED=false

# Machine Learning XGBoost Model Artifacts
MODEL_PATH=backend/model/fraud_model.json
MODEL_VERSION=1.0.0-synthetic

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Docker PostgreSQL Credentials (used by docker compose)
POSTGRES_DB=yogii_db
POSTGRES_USER=yogii_user
POSTGRES_PASSWORD=yogii_secret_password
